# Public (non-secret) build settings. Vite only exposes variables prefixed with VITE_.
# When the starapps.cl domain is live, change both lines and redeploy:
#   VITE_SITE_URL=https://starapps.cl
#   VITE_API_URL=            (empty = same origin, e.g. Cloudflare Pages Functions)
VITE_SITE_URL=https://rodolflying.github.io
VITE_API_URL=https://rodolflying-github-io.vercel.app
